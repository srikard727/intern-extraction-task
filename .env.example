ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_TIMEOUT_SECONDS=60

GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token_reader.json
GMAIL_QUERY='in:inbox newer_than:30d {subject:RFQ subject:"Request for Quote"}'
RFQ_LIMIT=30

RFQ_OCR_ENABLED=true
RFQ_OCR_LANGUAGE=eng
RFQ_OCR_DPI=300
RFQ_OCR_REVIEW_THRESHOLD=0.90
RFQ_OCR_MAX_PAGES=20
RFQ_OCR_TIMEOUT_SECONDS=60

RFQ_DB_PATH=outputs/rfq_extractions.db
RFQ_JSON_PATH=outputs/rfq_extractions.json

# Uncomment for PostgreSQL. Docker Compose sets this automatically.
# DATABASE_URL=postgresql://rfq:rfq@localhost:5432/rfq_extractions

# Docker Compose sets these to redis://redis:6379/... inside containers.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
